generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String?   @unique
  emailVerified   DateTime?
  image           String?
  midvaleHidden   Boolean   @default(false)
  accounts        Account[]
  sessions        Session[]
  tracks          Track[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Track {
  id                String  @id @default(cuid())
  userId            String
  spotifyId         String
  name              String
  artist            String
  album             String?
  imageUrl          String?
  previewUrl        String?
  // Written by the Spotify import. Existing rows stay null until they are
  // re-imported; nothing backfills or infers these.
  durationMs        Int?
  // Spotify's album release date, kept verbatim as a string because its
  // precision varies ("2019", "2019-04", "2019-04-12"). releaseDatePrecision
  // records which, so no consumer invents a month or day that was never given.
  releaseDate          String?
  releaseDatePrecision String?
  // Album structure, straight from Spotify. albumId is the identity key —
  // title strings collide across reissues, deluxe editions and rereleases, so
  // nothing may group albums by name. albumTotalTracks counts the whole album
  // across every disc, while trackNumber restarts on each disc, so a position
  // is the pair (discNumber, trackNumber) and never trackNumber alone.
  albumId              String?
  albumTotalTracks     Int?
  trackNumber          Int?
  discNumber           Int?
  /** "album" | "single" | "compilation". Only "album" supports completion. */
  albumType            String?
  rawGenre          String
  blueprintWorld    String
  blueprintSubgenre String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, spotifyId])
  @@index([albumId])
}
