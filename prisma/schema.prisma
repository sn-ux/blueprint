generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String                      @id @default(cuid())
  name          String?
  email         String?                     @unique
  emailVerified DateTime?
  image         String?
  midvaleHidden Boolean                     @default(false)
  accounts      Account[]
  sessions      Session[]
  tracks        Track[]
  exposures     RecommendationExposure[]
  feedSessions  RecommendationFeedSession[]
  notes         Note[]
  topArtists TopArtist[]
  topTracks  TopTrack[]
  plays      PlayEvent[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Track {
  id                   String   @id @default(cuid())
  userId               String
  spotifyId            String
  name                 String
  artist               String
  album                String?
  imageUrl             String?
  previewUrl           String?
  // Written by the Spotify import. Existing rows stay null until they are
  // re-imported; nothing backfills or infers these.
  durationMs           Int?
  // Spotify's album release date, kept verbatim as a string because its
  // precision varies ("2019", "2019-04", "2019-04-12"). releaseDatePrecision
  // records which, so no consumer invents a month or day that was never given.
  releaseDate          String?
  releaseDatePrecision String?
  // Album structure, straight from Spotify. albumId is the identity key —
  // title strings collide across reissues, deluxe editions and rereleases, so
  // nothing may group albums by name. albumTotalTracks counts the whole album
  // across every disc, while trackNumber restarts on each disc, so a position
  // is the pair (discNumber, trackNumber) and never trackNumber alone.
  albumId              String?
  albumTotalTracks     Int?
  trackNumber          Int?
  discNumber           Int?
  /**
   * "album" | "single" | "compilation". Only "album" supports completion.
   */
  albumType            String?
  // Artist identity and image. Spotify's track payload carries the artist id
  // but no picture, so the image is hydrated separately and stored here rather
  // than fetched per card.
  artistId             String?
  artistImageUrl       String?
  /**
   * When Spotify says this person saved it.
   *
   * `added_at` on a Liked Songs item, or on a playlist item for a track that
   * only arrives that way; where both exist the later one wins, because that
   * is when it last entered their library. Null on any row imported before
   * this was captured — nothing backfills or infers it, and nothing that reads
   * it may treat null as old or as new.
   */
  savedAt              DateTime?
  rawGenre             String
  blueprintWorld       String
  blueprintSubgenre    String
  /**
   * Touched by any write. The recommendation corpus is cached in process and
   * revalidated against the maximum of these per user, which costs five rows
   * instead of the whole table — so this is what makes an import or a backfill
   * visible without reading everything to find out whether anything changed.
   */
  updatedAt            DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, spotifyId])
  @@index([albumId])
  @@index([artistId])
}

/**
 * What has passed between one viewer and one recommendation.
 * Blueprint's feed is a stream, not a ranked list served fresh each launch, so
 * it has to remember which propositions this person has already been shown,
 * which they went and opened, and which they told it to stop showing. The row
 * is keyed on the proposition's stable identity — see
 * lib/discovery/identity.ts — never on feed position, so it survives the
 * engine re-running, the caption being reworded and the card moving.
 * `lastUnderlyingVersion` is what makes a familiar recommendation new again:
 * when the material behind it genuinely changes, the card can return early
 * instead of waiting out a cooldown earned by an older version of itself.
 */
model RecommendationExposure {
  id                String @id @default(cuid())
  userId            String
  recommendationKey String

  firstShownAt    DateTime?
  lastShownAt     DateTime?
  impressionCount Int       @default(0)

  firstOpenedAt DateTime?
  lastOpenedAt  DateTime?
  openCount     Int       @default(0)

  /**
   * An explicit "stop showing me this". Stands until the proposition changes.
   */
  dismissedAt DateTime?
  /**
   * The viewer acted on it. Resolution itself comes from the engine's exclusion.
   */
  actedOnAt   DateTime?

  cooldownUntil         DateTime?
  lastUnderlyingVersion String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, recommendationKey])
  @@index([userId, cooldownUntil])
  @@index([userId, dismissedAt])
}

/**
 * One reading session's fixed order.
 * Infinite scroll must not reorder underneath the reader: card twelve cannot
 * become card three because an impression was written while they were looking
 * at it. So ranking and lifecycle are evaluated once, when a session starts,
 * and the resulting sequence is frozen. Later pages slice it, which also means
 * a page fetch costs a row read rather than a full engine run.
 * The snapshot doubles as the detail payload's source, so the card on the
 * detail page is byte-for-byte the card in the feed — the same artwork, the
 * same caption, the same numbers — and opening one makes no external call.
 */
model RecommendationFeedSession {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  /**
   * How far generation has been pushed for this reading.
   * A session is a position in a widening search rather than a list: bands are
   * generated when the reader arrives at them, not up front.
   */
  depth     Int      @default(0)
  /**
   * How many times the reading has fallen back to resurfacing.
   */
  laps      Int      @default(0)
  /**
   * Ordered FeedCard snapshots plus each card's deliverable track ids.
   */
  cards     Json

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/**
 * A note one person wrote about something, readable by everyone who can see
 * that thing.
 * The target is an entity, not a card: `subjectIdentity()` in
 * lib/discovery/identity.ts already produces a key that is the same string for
 * every viewer — "artist:<spotify id>", "album:<spotify id>",
 * "subgenre:<canonical>", "genre:<canonical>", "set:<grouping key>". A
 * recommendation key would have been wrong here: it hashes the generator that
 * produced the card as well as its subject, so two people reaching the same
 * artist by different routes would not have found each other's notes.
 * Nothing about a feed position or a reading session is in this. A note
 * outlives the card that led to it.
 */
model Note {
  id         String   @id @default(cuid())
  authorId   String
  /**
   * "artist" | "album" | "subgenre" | "genre" | "set" — the target's kind.
   */
  targetType String
  /**
   * The whole stable key, kind included, exactly as subjectIdentity builds it.
   */
  targetKey  String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // The read is always "every note on this target, newest first".
  @@index([targetKey, createdAt])
  @@index([authorId])
}

/**
 * Behavioural signals, which are not library data.
 *
 * Three things Spotify knows that a saved library does not say: who somebody
 * has listened to most over a period, which songs, and what they have played
 * recently. None of it belongs in Track. A play is not a save, a top artist is
 * not an owned record, and nothing here may be read as either — so they are
 * their own tables, written by their own stage of the sync, and the corpus
 * that builds recommendations still reads Track and only Track.
 */

/**
 * An artist in one of this person's top-50 lists, at the rank Spotify gave.
 *
 * Kept as a dated snapshot rather than overwritten, because the evidence worth
 * having is persistence: an artist in the top fifty of three ranges, or in
 * this month's and last month's, is saying something a single list cannot.
 * One snapshot per range per day — a sync that runs hourly does not write
 * twenty-four copies of the same list.
 */
model TopArtist {
  id              String   @id @default(cuid())
  userId          String
  spotifyArtistId String
  name            String
  /** "short_term" (~4 weeks), "medium_term" (~6 months), "long_term" (years). */
  timeRange       String
  /** 1-based position in that list, as returned. */
  rank            Int
  /** Spotify's own genre strings for the artist, verbatim and unclassified. */
  genres          String[]
  popularity      Int?
  imageUrl        String?
  /** UTC midnight of the day this snapshot was taken. */
  capturedOn      DateTime
  fetchedAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, spotifyArtistId, timeRange, capturedOn])
  @@index([userId, timeRange, rank])
}

/** A track in one of this person's top-50 lists, at the rank Spotify gave. */
model TopTrack {
  id              String   @id @default(cuid())
  userId          String
  spotifyId       String
  name            String
  artist          String
  spotifyArtistId String?
  albumId         String?
  album           String?
  timeRange       String
  rank            Int
  popularity      Int?
  imageUrl        String?
  capturedOn      DateTime
  fetchedAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, spotifyId, timeRange, capturedOn])
  @@index([userId, timeRange, rank])
}

/**
 * One play, at the moment Spotify says it happened.
 *
 * Recently Played is a rolling window of the last fifty plays and nothing
 * older, so a single pull is a snapshot and only repeated pulls become a
 * record. Each play is keyed on when it happened, so re-reading the same
 * window adds nothing and a history accumulates instead of being overwritten.
 *
 * A row here says somebody played something. It does not say they saved it,
 * and nothing may promote it into their library.
 */
model PlayEvent {
  id              String   @id @default(cuid())
  userId          String
  spotifyId       String
  name            String
  artist          String
  spotifyArtistId String?
  albumId         String?
  album           String?
  imageUrl        String?
  /** Spotify's played_at, verbatim. Never the time of the sync. */
  playedAt        DateTime
  /** What it was played from — an album, a playlist, an artist page — if given. */
  contextUri      String?
  contextType     String?
  fetchedAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, spotifyId, playedAt])
  @@index([userId, playedAt])
}
